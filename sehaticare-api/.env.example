NODE_ENV=development
PORT=3100
SEED_DEMO_PASSWORD=
# Tambahkan origin LAN development secara eksplisit bila diperlukan, misalnya https://192.168.5.145:5173. Jangan gunakan wildcard.
CORS_ORIGINS=https://localhost:5173,https://127.0.0.1:5173
ENABLE_HSTS=false

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sehaticare?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_REAUTH_SECRET=replace-with-a-reauth-32-random-characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

INTERNAL_AI_TOKEN=replace-with-a-random-internal-token
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_ENABLED=false
AI_COOLDOWN_SECONDS=30
AI_API_KEY=

STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=sehaticare-voice-notes
STORAGE_ACCESS_KEY=replace-with-storage-access-key
STORAGE_SECRET_KEY=replace-with-storage-secret-key
STORAGE_USE_SSL=false
STORAGE_SIGNED_URL_TTL_SECONDS=300
STAGE4_RETENTION_DAYS=365
STAGE4_RETENTION_MODE=RESTRICT
STAGE4_LEGAL_HOLD_ENABLED=false
STATISTICS_MINIMUM_PUBLIC_COUNT=5
STORAGE_PUBLIC_BASE_URL=http://localhost:9000
