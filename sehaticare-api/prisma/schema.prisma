  id                 String              @id @db.Uuid
  section            String
  title              String
  summary            String              @default("")
  link_url           String?
  media_url          String?
  article_id         String?             @db.Uuid
  video_id           String?             @db.Uuid
  publication_status publication_status  @default(DRAFT)
  display_order      Int                 @default(1)
  created_by         String?             @db.Uuid
  updated_by         String?             @db.Uuid
  created_at         DateTime            @default(now())
  updated_at         DateTime            @default(now())
  article            education_articles? @relation(fields: [article_id], references: [id])
  video              education_videos?   @relation(fields: [video_id], references: [id])
  creator            users?              @relation("portal_content_created_by", fields: [created_by], references: [id])
  updater            users?              @relation("portal_content_updated_by", fields: [updated_by], references: [id])

  @@index([section, publication_status, display_order])
  @@index([article_id])
  @@index([video_id])
}

