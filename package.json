{
  "name": "sehaticare",
  "private": true,
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:api": "npm --prefix sehaticare-api run dev",
    "dev:web": "npm --prefix sehaticare-web run dev",
    "build": "npm --prefix sehaticare-api run build",
    "start": "npm --prefix sehaticare-api start",
    "seed": "npm --prefix sehaticare-api run seed",
    "seed:content": "npm --prefix sehaticare-api run seed:content",
    "prisma:generate": "npm --prefix sehaticare-api run prisma:generate",
    "prisma:migrate": "npm --prefix sehaticare-api run prisma:migrate",
    "db:deploy": "npm --prefix sehaticare-api run db:deploy",
    "lint": "npm --prefix sehaticare-api run lint",
    "test": "npm --prefix sehaticare-api test"
  },
  "engines": {
    "node": ">=18"
  }
}
