generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ai_events {
  id              String        @id @db.Uuid
  consultation_id String        @db.Uuid
  trigger         String
  request_payload Json
  response_text   String?
  created_at      DateTime      @default(now())
  consultations   consultations @relation(fields: [consultation_id], references: [id])
}

model audit_events {
  id              String     @id @db.Uuid
  created_at      DateTime   @default(now())
  actor_user_id   String?    @db.Uuid
  actor_role      user_role?
  action          String
  consultation_id String?    @db.Uuid
  meta_json       Json?

  @@index([action, created_at])
  @@index([actor_user_id, created_at])
  @@index([consultation_id, created_at])
}

model audit_logs {
  id            String   @id @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String
  entity_type   String
  entity_id     String   @db.Uuid
  meta          Json
  ip_address    String?
  user_agent    String?
  created_at    DateTime @default(now())
  users         users?   @relation(fields: [actor_user_id], references: [id])
}

model chat_messages {
  id              String           @id @db.Uuid
  consultation_id String           @db.Uuid
  sender_role     chat_sender_role
  sender_user_id  String?          @db.Uuid
  content         String
  voice_note_id   String?          @unique @db.Uuid
  created_at      DateTime         @default(now())
  consultations   consultations    @relation(fields: [consultation_id], references: [id])
  voice_note      voice_notes?     @relation("chat_messages_voice_note", fields: [voice_note_id], references: [id])

  @@index([consultation_id, created_at])
}

model consultation_messages {
  id              String        @id @db.Uuid
  consultation_id String        @db.Uuid
  sender          sender_type
  sender_user_id  String?       @db.Uuid
  type            message_type
  content_text    String?
  voice_note_id   String?       @unique @db.Uuid
  created_at      DateTime      @default(now())
  deleted_at      DateTime?
  consultations   consultations @relation(fields: [consultation_id], references: [id])
  users           users?        @relation(fields: [sender_user_id], references: [id])
  voice_notes     voice_notes?  @relation(fields: [voice_note_id], references: [id])

  @@index([consultation_id, created_at(sort: Desc)])
}

model consultation_participants {
  id              String        @id @db.Uuid
  consultation_id String        @db.Uuid
  user_id         String        @db.Uuid
  role            user_role
  joined_at       DateTime      @default(now())
  left_at         DateTime?
  consultations   consultations @relation(fields: [consultation_id], references: [id])
  users           users         @relation(fields: [user_id], references: [id])

  @@unique([consultation_id, user_id])
}

model consultations {
  id                                            String                       @id @db.Uuid
  patient_id                                    String                       @db.Uuid
  assignedDoctorId                              String?                      @map("doctor_id") @db.Uuid
  status                                        consultation_status          @default(MENUNGGU_DOKTER)
  initial_complaint                             String
  opened_at                                     DateTime                     @default(now())
  doctor_joined_at                              DateTime?
  closed_at                                     DateTime?
  closed_by                                     String?                      @db.Uuid
  created_at                                    DateTime                     @default(now())
  updated_at                                    DateTime
  closeRequested                                Boolean                      @default(false)
  closeRequestedAt                              DateTime?
  closeRequestedById                            String?                      @db.Uuid
  closedReason                                  String?
  consent_at                                    DateTime?
  consent_version                               String?
  priority                                      Int                          @default(0)
  red_flag                                      Boolean                      @default(false)
  red_flag_reason                               String?
  ai_events                                     ai_events[]
  chat_messages                                 chat_messages[]
  consultation_messages                         consultation_messages[]
  consultation_participants                     consultation_participants[]
  users_consultations_closeRequestedByIdTousers users?                       @relation("consultations_closeRequestedByIdTousers", fields: [closeRequestedById], references: [id])
  users_consultations_closed_byTousers          users?                       @relation("consultations_closed_byTousers", fields: [closed_by], references: [id])
  assignedDoctor                                users?                       @relation("consultations_doctor_idTousers", fields: [assignedDoctorId], references: [id])
  patient                                       users                        @relation("consultations_patient_idTousers", fields: [patient_id], references: [id])
  voice_note_upload_sessions                    voice_note_upload_sessions[]
  voice_notes                                   voice_notes[]

  @@index([assignedDoctorId, opened_at(sort: Desc)])
  @@index([patient_id, opened_at(sort: Desc)])
  @@index([status, opened_at])
}

model doctor_profiles {
  user_id                                  String                     @id @db.Uuid
  verification_status                      doctor_verification_status @default(PENDING)
  verified_at                              DateTime?
  verified_by                              String?                    @db.Uuid
  puskesmas_name                           String?
  str_number                               String?
  created_at                               DateTime                   @default(now())
  updated_at                               DateTime
  users_doctor_profiles_user_idTousers     users                      @relation("doctor_profiles_user_idTousers", fields: [user_id], references: [id])
  users_doctor_profiles_verified_byTousers users?                     @relation("doctor_profiles_verified_byTousers", fields: [verified_by], references: [id])

  @@index([verification_status])
}

model counselor_profiles {
  user_id                  String                     @id @db.Uuid
  permission_enabled       Boolean                    @default(false)
  verification_status      doctor_verification_status @default(PENDING)
  professional_name        String
  profession               String
  service_role             professional_service_role @default(COUNSELOR)
  facility_id              String?                    @db.Uuid
  region_id                String?                    @db.Uuid
  competencies             String[]                   @default([])
  languages                String[]                   @default(["Bahasa Indonesia"])
  active_days              Int[]                      @default([1, 2, 3, 4, 5])
  opens_at                 String                     @default("08:00")
  closes_at                String                     @default("16:00")
  timezone                 String                     @default("Asia/Jayapura")
  is_available             Boolean                    @default(false)
  max_active_conversations Int                        @default(10)
  is_active                Boolean                    @default(true)
  verified_at              DateTime?
  verified_by              String?                    @db.Uuid
  created_at               DateTime                   @default(now())
  updated_at               DateTime
  user                     users                      @relation("counselor_profile_user", fields: [user_id], references: [id])
  verifier                 users?                     @relation("counselor_profile_verifier", fields: [verified_by], references: [id])
  facility                 health_facilities?         @relation(fields: [facility_id], references: [id])
  region                   regions?                   @relation(fields: [region_id], references: [id])

  @@index([permission_enabled, verification_status, is_active, is_available])
  @@index([facility_id, region_id])
}

model counselor_applications {
  id                       String                               @id @db.Uuid
  public_id                String                               @unique @default(dbgenerated("'cap_' || replace(gen_random_uuid()::text, '-', '')"))
  user_id                  String                               @unique @db.Uuid
  status                   counselor_application_status         @default(DRAFT)
  professional_name        String
  profession               String
  service_role             professional_service_role              @default(COUNSELOR)
  license_number           String?
  facility_id              String?                              @db.Uuid
  region_id                String?                              @db.Uuid
  competencies             String[]                             @default([])
  languages                String[]                             @default(["Bahasa Indonesia"])
  active_days              Int[]                                @default([1, 2, 3, 4, 5])
  opens_at                 String                               @default("08:00")
  closes_at                String                               @default("16:00")
  timezone                 String                               @default("Asia/Jayapura")
  max_active_conversations Int                                  @default(10)
  applicant_notes          String?
  revision_notes           String?
  rejection_reason         String?
  submitted_at             DateTime?
  reviewed_at              DateTime?
  verified_at              DateTime?
  activated_at             DateTime?
  created_at               DateTime                             @default(now())
  updated_at               DateTime
  user                     users                                @relation("counselor_application_user", fields: [user_id], references: [id])
  documents                counselor_documents[]
  upload_sessions          counselor_document_upload_sessions[]
  review_events            counselor_review_events[]
  status_history           counselor_status_history[]

  @@index([status, submitted_at])
}

model counselor_document_upload_sessions {
  id              String                  @id @db.Uuid
  application_id  String                  @db.Uuid
  requested_by    String                  @db.Uuid
  document_type   counselor_document_type
  storage_key     String                  @unique
  content_type    String
  file_size_bytes Int
  expires_at      DateTime
  committed_at    DateTime?
  created_at      DateTime                @default(now())
  application     counselor_applications  @relation(fields: [application_id], references: [id])

  @@index([application_id, created_at])
  @@index([expires_at, committed_at])
}

model counselor_documents {
  id              String                  @id @db.Uuid
  public_id       String                  @unique @default(dbgenerated("'cdoc_' || replace(gen_random_uuid()::text, '-', '')"))
  application_id  String                  @db.Uuid
  uploaded_by     String                  @db.Uuid
  document_type   counselor_document_type
  storage_key     String                  @unique
  content_type    String
  file_size_bytes Int
  status          String                  @default("ACTIVE")
  reviewed_at     DateTime?
  created_at      DateTime                @default(now())
  application     counselor_applications  @relation(fields: [application_id], references: [id])

  @@index([application_id, document_type, created_at])
}

model counselor_review_events {
  id             String                 @id @db.Uuid
  application_id String                 @db.Uuid
  actor_user_id  String                 @db.Uuid
  action         String
  reason         String?
  safe_metadata  Json?
  created_at     DateTime               @default(now())
  application    counselor_applications @relation(fields: [application_id], references: [id])

  @@index([application_id, created_at])
}

model counselor_status_history {
  id             String                        @id @db.Uuid
  application_id String                        @db.Uuid
  changed_by     String                        @db.Uuid
  from_status    counselor_application_status?
  to_status      counselor_application_status
  reason         String?
  created_at     DateTime                      @default(now())
  application    counselor_applications        @relation(fields: [application_id], references: [id])

  @@index([application_id, created_at])
}

model education_articles {
  id                                         String              @id @db.Uuid
  title                                      String
  slug                                       String              @unique
  body_markdown                              String
  is_published                               Boolean             @default(false)
  published_at                               DateTime?
  created_by                                 String?             @db.Uuid
  updated_by                                 String?             @db.Uuid
  created_at                                 DateTime            @default(now())
  updated_at                                 DateTime
  summary                                    String              @default("")
  category_id                                String?             @db.Uuid
  thumbnail_key                              String?
  thumbnail_alt                              String?
  language                                   String              @default("id")
  reviewer_id                                String?             @db.Uuid
  publisher_id                               String?             @db.Uuid
  publication_status                         publication_status  @default(DRAFT)
  source_reference                           String?
  reading_minutes                            Int                 @default(1)
  featured                                   Boolean             @default(false)
  content_categories                         content_categories? @relation(fields: [category_id], references: [id])
  users_education_articles_created_byTousers users?              @relation("education_articles_created_byTousers", fields: [created_by], references: [id])
  users_education_articles_updated_byTousers users?              @relation("education_articles_updated_byTousers", fields: [updated_by], references: [id])
  portal_contents                            portal_contents[]
}

model regions {
  id                       String                     @id @db.Uuid
  code                     String                     @unique
  name                     String
  type                     region_type
  parent_id                String?                    @db.Uuid
  is_active                Boolean                    @default(true)
  created_at               DateTime                   @default(now())
  updated_at               DateTime
  parent                   regions?                   @relation("region_hierarchy", fields: [parent_id], references: [id])
  children                 regions[]                  @relation("region_hierarchy")
  case_statistics          case_statistics[]
  health_facilities        health_facilities[]
  counselor_profiles       counselor_profiles[]
  consultation_preferences consultation_preferences[]
  outreach_cases           professional_outreach_cases[]

  @@index([parent_id, is_active])
  @@index([name])
}

model content_categories {
  id                 String               @id @db.Uuid
  slug               String               @unique
  name               String
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now())
  updated_at         DateTime
  education_articles education_articles[]
  education_videos   education_videos[]
}

model case_statistics {
  id                 String             @id @db.Uuid
  region_id          String             @db.Uuid
  period_start       DateTime
  period_end         DateTime
  year               Int
  period_type        period_type
  case_count         Int
  data_category      String
  source_name        String
  source_publication String?
  source_url         String?
  updated_on         DateTime
  methodology_note   String?
  publication_status publication_status @default(DRAFT)
  is_sample          Boolean            @default(false)
  created_by         String?            @db.Uuid
  reviewer_id        String?            @db.Uuid
  publisher_id       String?            @db.Uuid
  published_at       DateTime?
  created_at         DateTime           @default(now())
  updated_at         DateTime
  regions            regions            @relation(fields: [region_id], references: [id])

  @@index([publication_status, year, region_id])
  @@index([region_id, period_start, period_end])
}

model education_videos {
  id                 String              @id @db.Uuid
  title              String
  description        String
  category_id        String?             @db.Uuid
  source_type        video_source_type
  storage_key        String?
  external_url       String?
  thumbnail_key      String?
  thumbnail_alt      String
  duration_seconds   Int?
  file_size_bytes    Int?
  language           String              @default("id")
  subtitle_text      String
  transcript_text    String
  speaker_type       speaker_type        @default(GENERAL)
  publication_status publication_status  @default(DRAFT)
  created_by         String?             @db.Uuid
  reviewer_id        String?             @db.Uuid
  publisher_id       String?             @db.Uuid
  published_at       DateTime?
  created_at         DateTime            @default(now())
  updated_at         DateTime
  content_categories content_categories? @relation(fields: [category_id], references: [id])
  media_consents     media_consents[]
  portal_contents    portal_contents[]

  @@index([publication_status, published_at])
}

model media_consents {
  id                   String           @id @db.Uuid
  media_id             String           @db.Uuid
  subject_type         String
  subject_reference    String
  consent_version      String
  scope                String
  status               consent_status   @default(PENDING)
  approved_at          DateTime?
  expires_at           DateTime?
  withdrawn_at         DateTime?
  document_storage_key String?
  recorded_by          String?          @db.Uuid
  reviewed_by          String?          @db.Uuid
  created_at           DateTime         @default(now())
  updated_at           DateTime
  education_videos     education_videos @relation(fields: [media_id], references: [id])

  @@index([media_id, status])
}

model health_facilities {
  id                       String                       @id @db.Uuid
  name                     String
  facility_type            facility_type
  region_id                String                       @db.Uuid
  district_name            String?
  address                  String
  public_contact           String?
  service_hours            String
  description              String?
  latitude                 Decimal?                     @db.Decimal(9, 6)
  longitude                Decimal?                     @db.Decimal(9, 6)
  is_active                Boolean                      @default(true)
  verification_status      facility_verification_status @default(DRAFT)
  verified_at              DateTime?
  source_name              String
  is_sample                Boolean                      @default(false)
  created_by               String?                      @db.Uuid
  updated_by               String?                      @db.Uuid
  created_at               DateTime                     @default(now())
  updated_at               DateTime
  regions                  regions                      @relation(fields: [region_id], references: [id])
  facility_services        facility_services[]
  control_schedules        control_schedules[]
  counselor_profiles       counselor_profiles[]
  consultation_preferences consultation_preferences[]

  @@index([region_id, facility_type, verification_status, is_active])
  @@index([name])
}

model facility_services {
  facility_id String                @db.Uuid
  service     facility_service_type
  verified    Boolean               @default(false)
  facilities  health_facilities     @relation(fields: [facility_id], references: [id])

  @@id([facility_id, service])
  @@index([service, verified])
}

model otp_requests {
  id            String      @id @db.Uuid
  phone_e164    String?
  email         String?
  purpose       otp_purpose
  otp_hash      String
  otp_salt      String
  expires_at    DateTime
  verified_at   DateTime?
  attempt_count Int         @default(0)
  ip_address    String?
  user_agent    String?
  created_at    DateTime    @default(now())

  @@index([email, created_at])
  @@index([phone_e164, created_at])
}

model refresh_tokens {
  id         String    @id @db.Uuid
  user_id    String    @db.Uuid
  token_hash String
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())
  users      users     @relation(fields: [user_id], references: [id])
}

model account_consents {
  id             String       @id @db.Uuid
  user_id        String       @db.Uuid
  consent_type   consent_type
  policy_version String
  accepted_at    DateTime     @default(now())
  source         String
  users          users        @relation(fields: [user_id], references: [id])

  @@unique([user_id, consent_type, policy_version])
  @@index([user_id, accepted_at])
}

model users {
  id                                                      String                       @id @db.Uuid
  public_id                                               String                       @unique @default(dbgenerated("'usr_' || replace(gen_random_uuid()::text, '-', '')"))
  login_id                                                String?                      @unique
  display_alias                                           String?
  account_mode                                            account_mode                 @default(LEGACY)
  recovery_code_hash                                      String?
  recovery_enabled                                        Boolean                      @default(false)
  credentials_shown_at                                    DateTime?
  last_alias_changed_at                                   DateTime?
  avatar_key                                              String?                      @default("avatar-leaf")
  preferred_language                                      String                       @default("id")
  timezone                                                String                       @default("Asia/Jayapura")
  accessibility_preferences                               Json?
  notification_preferences                                Json?
  session_version                                         Int                          @default(0)
  role                                                    user_role                    @default(PASIEN)
  is_superadmin                                           Boolean                      @default(false)
  phone_e164                                              String?                      @unique
  email                                                   String?                      @unique
  full_name                                               String
  is_active                                               Boolean                      @default(true)
  created_at                                              DateTime                     @default(now())
  updated_at                                              DateTime
  password_hash                                           String?
  account_consents                                        account_consents[]
  audit_logs                                              audit_logs[]
  consultation_messages                                   consultation_messages[]
  consultation_participants                               consultation_participants[]
  consultations_consultations_closeRequestedByIdTousers   consultations[]              @relation("consultations_closeRequestedByIdTousers")
  consultations_consultations_closed_byTousers            consultations[]              @relation("consultations_closed_byTousers")
  consultations_consultations_doctor_idTousers            consultations[]              @relation("consultations_doctor_idTousers")
  consultations_consultations_patient_idTousers           consultations[]              @relation("consultations_patient_idTousers")
  doctor_profiles_doctor_profiles_user_idTousers          doctor_profiles?             @relation("doctor_profiles_user_idTousers")
  doctor_profiles_doctor_profiles_verified_byTousers      doctor_profiles[]            @relation("doctor_profiles_verified_byTousers")
  education_articles_education_articles_created_byTousers education_articles[]         @relation("education_articles_created_byTousers")
  education_articles_education_articles_updated_byTousers education_articles[]         @relation("education_articles_updated_byTousers")
  refresh_tokens                                          refresh_tokens[]
  voice_note_upload_sessions                              voice_note_upload_sessions[]
  voice_notes                                             voice_notes[]
  control_schedules                                       control_schedules[]          @relation("control_schedule_owner")
  control_schedules_as_worker                             control_schedules[]          @relation("control_schedule_worker")
  medication_reminders                                    medication_reminders[]
  medication_occurrences                                  medication_occurrences[]
  notification_preference                                 notification_preferences?
  notification_deliveries                                 notification_deliveries[]
  service_conversations_owned                             service_conversations[]      @relation("service_conversation_owner")
  service_conversations_assigned                          service_conversations[]      @relation("service_conversation_counselor")
  counselor_assignments_as_counselor                      counselor_assignments[]      @relation("counselor_assignment_counselor")
  counselor_assignments_as_assigner                       counselor_assignments[]      @relation("counselor_assignment_assigner")
  service_messages                                        service_messages[]
  message_receipts                                        message_receipts[]
  conversation_reports                                    conversation_reports[]
  conversation_blocks                                     conversation_blocks[]        @relation("conversation_block_user")
  conversation_blocks_as_counselor                        conversation_blocks[]        @relation("conversation_block_counselor")
  complaint_tickets                                       complaint_tickets[]          @relation("complaint_owner")
  complaint_tickets_assigned                              complaint_tickets[]          @relation("complaint_officer")
  complaint_messages                                      complaint_messages[]
  complaint_assignments_as_officer                        complaint_assignments[]      @relation("complaint_assignment_officer")
  complaint_assignments_as_assigner                       complaint_assignments[]      @relation("complaint_assignment_assigner")
  sensitive_access_audits                                 sensitive_access_audits[]
  counselor_profile                                       counselor_profiles?          @relation("counselor_profile_user")
  counselor_application                                   counselor_applications?      @relation("counselor_application_user")
  counselor_profiles_verified                             counselor_profiles[]         @relation("counselor_profile_verifier")
  counselor_conflicts_as_patient                          counselor_conflicts[]        @relation("counselor_conflict_patient")
  counselor_conflicts_as_counselor                        counselor_conflicts[]        @relation("counselor_conflict_counselor")
  consultation_preferences_selected                       consultation_preferences[]   @relation("consultation_preference_selected")
  consultation_preferences_recommended                    consultation_preferences[]   @relation("consultation_preference_recommended")
  outreach_cases_created                                  professional_outreach_cases[] @relation("outreach_case_creator")
  portal_contents_created                                 portal_contents[]            @relation("portal_content_created_by")
  portal_contents_updated                                 portal_contents[]            @relation("portal_content_updated_by")
}

model professional_outreach_cases {
  id                 String                    @id @db.Uuid
  public_id          String                    @unique @default(dbgenerated("'out_' || replace(gen_random_uuid()::text, '-', '')"))
  created_by         String                    @db.Uuid
  title              String
  summary            String
  region_id          String?                   @db.Uuid
  status             outreach_case_status      @default(OPEN)
  referral_target    outreach_referral_target?
  referral_note      String?
  referred_at        DateTime?
  closed_at          DateTime?
  created_at         DateTime                  @default(now())
  updated_at         DateTime
  creator            users                     @relation("outreach_case_creator", fields: [created_by], references: [id])
  region             regions?                  @relation(fields: [region_id], references: [id])

  @@index([created_by, status, updated_at])
  @@index([region_id, status])
}

model voice_note_upload_sessions {
  id               String        @id @db.Uuid
  consultation_id  String        @db.Uuid
  requested_by     String        @db.Uuid
  storage_provider String
  storage_key      String
  upload_url       String?
  content_type     String?
  file_size_bytes  Int?
  expires_at       DateTime
  committed_at     DateTime?
  created_at       DateTime      @default(now())
  consultations    consultations @relation(fields: [consultation_id], references: [id])
  users            users         @relation(fields: [requested_by], references: [id])
}

model voice_notes {
  id                    String                 @id @db.Uuid
  consultation_id       String                 @db.Uuid
  uploaded_by           String                 @db.Uuid
  storage_provider      String
  storage_key           String
  content_type          String
  file_size_bytes       Int
  stt_status            String?
  transcript_text       String?
  stt_engine            String?
  stt_error             String?
  created_at            DateTime               @default(now())
  updated_at            DateTime
  deleted_at            DateTime?
  consultation_messages consultation_messages?
  chat_message          chat_messages?         @relation("chat_messages_voice_note")
  consultations         consultations          @relation(fields: [consultation_id], references: [id])
  users                 users                  @relation(fields: [uploaded_by], references: [id])

  @@index([consultation_id, created_at])
}

enum user_role {
