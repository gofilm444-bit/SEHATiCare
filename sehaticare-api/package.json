{
  "name": "sehaticare-api",
  "version": "0.1.0",
  "description": "SEHATiCare API - edukasi, konsultasi, dan pendampingan kesehatan berbasis empati.",
  "main": "dist/server.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:deploy": "ts-node prisma/deploy.ts",
    "prisma:backfill:anonymous": "ts-node prisma/backfill-anonymous-identities.ts",
    "admin:promote-superadmin": "ts-node prisma/promote-superadmin.ts",
    "seed": "ts-node prisma/seed.ts",
    "seed:stage2": "ts-node prisma/seed-stage2.ts",
    "seed:content": "ts-node prisma/seed-verified-content.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test -r ts-node/register tests/security.test.ts tests/account.test.ts tests/admin-account-management.test.ts tests/stage2-content.test.ts tests/stage3-health-planning.test.ts tests/stage4-counselor-complaints.test.ts tests/professional-roles.test.ts tests/unified-consultations.test.ts tests/finalization-pre-flowchart.test.ts tests/portal-cms.test.ts tests/companion-assignments.test.ts tests/companion-routing.test.ts tests/hiv-care-monitoring.test.ts tests/art-care.test.ts tests/art-refill-side-effects.test.ts tests/care-signals-escalation.test.ts tests/confidential-referrals.test.ts tests/referrals-lifecycle-audit.test.ts tests/device-privacy-safety.test.ts tests/jwt-type-isolation.test.ts",
    "test:admin-accounts": "node --test -r ts-node/register tests/admin-account-management.test.ts",
    "test:unified-consultations": "node --test -r ts-node/register tests/unified-consultations.e2e.test.ts",
    "test:stage3": "node --test -r ts-node/register tests/stage3-health-planning.e2e.test.ts",
    "test:stage4": "node --test -r ts-node/register tests/stage4-counselor-complaints.e2e.test.ts",
    "test:professional-roles": "node --test -r ts-node/register tests/professional-roles.e2e.test.ts",
    "test:stage4:storage": "node --test -r ts-node/register tests/stage4-storage.e2e.test.ts",
    "test:stage2": "node --test -r ts-node/register tests/stage2-content.e2e.test.ts",
    "test:stage2:storage": "node --test -r ts-node/register tests/stage2-storage.e2e.test.ts",
    "test:stage1": "node --test -r ts-node/register tests/stage1-anonymous.e2e.test.ts",
    "test:gate:postgres": "node --test -r ts-node/register tests/gate-postgresql.e2e.test.ts",
    "test:gate:voice": "node --test -r ts-node/register tests/gate-voice-note.e2e.test.ts"
    ,"test:finalization:e2e": "node --test -r ts-node/register tests/finalization-workflow.e2e.test.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^5.11.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.11.2",
    "fastify-plugin": "^6.0.0",
    "minio": "^8.0.7",
    "pino": "^9.2.0",
    "prisma": "^5.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.1.0"
  }
}
